# Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudresilience
DB_USER=postgres
DB_PASSWORD=change_me
DB_LOGGING=false
# TLS to the database (managed PostgreSQL). Leave false locally.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Max connections per service and how long a request may wait for one (ms)
DB_POOL_MAX=5
DB_POOL_ACQUIRE_MS=10000

# Logging (JSON to stdout): trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Lifecycle
# /ready fails a dependency check that takes longer than this (ms)
READY_CHECK_TIMEOUT_MS=2000
# On SIGTERM, wait this long for in-flight requests before forcing exit (ms)
SHUTDOWN_TIMEOUT_MS=10000

# JWT used by every local service
JWT_SECRET=change_me
JWT_EXPIRES_IN=24h

# Frontend origin for CORS
CORS_ORIGIN=http://localhost:5173

# Local service ports
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
INVENTORY_SERVICE_PORT=3003
ORDER_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# Local service URLs used by Order Service
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Shared by Inventory Service and Order Service so customers cannot
# call reserve/release directly. Order Service sends this as X-Internal-Token.
INTERNAL_SERVICE_TOKEN=change_me_internal

# Synthetic probe account used by scripts/e2e-business-flow.js (and later the
# BCDR business validator). Created by the bcdr-probe seeder from these values.
BCDR_PROBE_EMAIL=bcdr-probe@example.com
BCDR_PROBE_PASSWORD=change_me_probe
