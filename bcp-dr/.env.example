# Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudresilience
DB_USER=postgres
DB_PASSWORD=change_me
DB_LOGGING=false

# JWT used by every local service
JWT_SECRET=change_me
JWT_EXPIRES_IN=24h

# Frontend origin for CORS
CORS_ORIGIN=http://localhost:5173

# Local service ports
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
INVENTORY_SERVICE_PORT=3003
ORDER_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# Local service URLs used by Order Service
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Shared by Inventory Service and Order Service so customers cannot
# call reserve/release directly. Order Service sends this as X-Internal-Token.
INTERNAL_SERVICE_TOKEN=change_me_internal
