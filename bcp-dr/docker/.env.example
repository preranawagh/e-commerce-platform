# Copy to docker/.env and replace every change_me value (docker/.env is git-ignored).
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

DB_NAME=cloudresilience
DB_USER=cloudresilience
DB_PASSWORD=change_me

JWT_SECRET=change_me
JWT_EXPIRES_IN=24h
INTERNAL_SERVICE_TOKEN=change_me_internal

# Synthetic probe account created by the migrate container and used by
# `npm run e2e:docker` (which reads this file).
BCDR_PROBE_EMAIL=bcdr-probe@example.com
BCDR_PROBE_PASSWORD=change_me_probe

LOG_LEVEL=info

# Host port for the web app (nginx listens on 8080 inside the container).
FRONTEND_PORT=8088
