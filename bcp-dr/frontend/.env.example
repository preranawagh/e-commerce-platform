# Optional. By default the frontend calls same-origin /api/... paths:
# - `npm run dev` proxies them to the local services (see vite.config.js)
# - the container's nginx and the Kubernetes Ingress route them to the services
# Set these only to call a service on a different origin directly.
# VITE_USER_SERVICE_URL=http://localhost:3001
# VITE_PRODUCT_SERVICE_URL=http://localhost:3002
# VITE_INVENTORY_SERVICE_URL=http://localhost:3003
# VITE_ORDER_SERVICE_URL=http://localhost:3004
# VITE_NOTIFICATION_SERVICE_URL=http://localhost:3005
